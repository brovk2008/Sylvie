{
  "name": "sylvie-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sylvie — AI-Powered Personal Stylist Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "start:web": "npm run start --workspace=apps/web",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build:packages": "npm run build --workspaces --if-present"
  },
  "keywords": [
    "fashion",
    "ai",
    "stylist",
    "expo",
    "nextjs",
    "fastapi"
  ],
  "author": "Sylvie Fashion Systems",
  "license": "UNLICENSED"
}
